{
  "name": "hallmonitor",
  "version": "1.0.0",
  "description": "HallMonitor - K-12 Cybersecurity Operations Dashboard by CyberReady",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "node server/index.js --production",
    "test": "node --test tests/smoke.test.mjs"
  },
  "keywords": [
    "cybersecurity",
    "k-12",
    "dashboard"
  ],
  "author": "CyberReady",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
