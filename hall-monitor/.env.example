# Required in production
SESSION_SECRET=your-strong-random-secret-here

# Optional overrides
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=

# Required demo credentials (only used during initial seed; set unique values before first run)
DEMO_ADMIN_USER=demo-admin
DEMO_ADMIN_PASS=replace-with-a-unique-admin-password
DEMO_DISTRICT_IT_USER=demo-district-it
DEMO_DISTRICT_IT_PASS=replace-with-a-unique-district-password
DEMO_SUPERINTENDENT_USER=demo-superintendent
DEMO_SUPERINTENDENT_PASS=replace-with-a-unique-superintendent-password
